generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  admin
  operator
  viewer
}

model AppUser {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            AppRole   @default(viewer)
  totpSecretEnc   String?
  totpEnabled     Boolean   @default(false)
  totpVerifiedAt  DateTime?
  deviceFingerprint String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id            String   @id @default(uuid())
  sid           String   @unique // HHST, 5 digits, e.g. 23045
  sgid          String   // government Schulnummer, e.g. 50267
  soid          String   // derived last 2 of SID, e.g. 45
  name          String
  schoolType    String   // Grundschule, Regelschule, Gymnasium, ...
  config        Json     @default("{}")
  amsLocationId String   @unique @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  persons       PersonSchool[]
  classes       SchoolClass[]
}

model SchoolClass {
  id        String   @id @default(uuid())
  schoolId  String
  lkid      String   // from groupsextension LKGREIZ_GRID
  name      String   // SHORT0, e.g. "9b"
  classKey  String   // sid-name, e.g. "23045-9b"
  active    Boolean  @default(true)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, name])
  @@index([lkid])
}

model RoleDefinition {
  id       String @id @default(uuid())
  vceType  Int    @unique // 411, 421, 431
  dataId   String @unique // e.g. "Lehrer", "Schueler"
  label    String
  aliases  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persons  PersonRole[]
}

model FlagDefinition {
  id        String   @id @default(uuid())
  dataId    String   @unique // mdm, cloud, dvv, print, iot
  label     String
  requires  String[] // dataIds of required flags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persons   PersonFlag[]
  groups    GroupFlag[]
}

model GroupFlag {
  id       String   @id @default(uuid())
  flagId   String
  roleId   String?
  schoolId String?
  flag     FlagDefinition @relation(fields: [flagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([flagId, roleId, schoolId])
}

model Person {
  id              String   @id @default(uuid())
  lkid            String   @unique // SID-YYYY-NNNNN
  amsId           String   @unique @default(uuid())
  // Encrypted envelope fields (ciphertext + iv + tag + wrappedDek)
  nameEnc         String
  firstNameEnc    String
  emailEnc        String?
  workEmailEnc    String?
  passwordEnc     String?
  // Plain / indexed
  dateOfBirth     DateTime?
  username        String   @unique
  appleId         String?
  systemEmail     String?
  schoolStart     DateTime?
  schoolEnd       DateTime?
  stufe           String?  // grade from XML STUFE
  active          Boolean  @default(true)
  sex             String?  // m/w/d
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  schools         PersonSchool[]
  roles           PersonRole[]
  flags           PersonFlag[]
  classes         PersonClass[]
  versions        PersonVersion[]
}

model PersonSchool {
  personId String
  schoolId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@id([personId, schoolId])
}

model PersonRole {
  personId String
  roleId   String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     RoleDefinition @relation(fields: [roleId], references: [id])
  @@id([personId, roleId])
}

model PersonFlag {
  personId String
  flagId   String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  flag     FlagDefinition @relation(fields: [flagId], references: [id])
  @@id([personId, flagId])
}

model PersonClass {
  id       String @id @default(uuid())
  personId String
  schoolId String
  classKey String // e.g. "23045-5a"
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@unique([personId, classKey])
}

model PersonVersion {
  id        String   @id @default(uuid())
  personId  String
  version   Int
  snapshot  Json     // encrypted snapshot or redacted
  changedBy String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id        String   @id @default(uuid())
  filename  String
  status    String
  stats     Json?
  errors    Json?
  createdAt DateTime @default(now())
  createdBy String?
}

model PasswordRevealLog {
  id        String   @id @default(uuid())
  userId    String
  scope     String
  ref       String?
  createdAt DateTime @default(now())
}