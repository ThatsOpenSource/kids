// KIDS – Prisma schema
// Sensitive person fields: AES-GCM ciphertext in columns (no "_enc" suffix).
// Lookup / uniqueness via blind indexes (*Hash = SHA-256 hex of normalized plaintext).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppUserRole {
  admin
  operator
  viewer
}

enum SchoolType {
  grundschule
  regelschule
  gymnasium
  sonstige
}

model AppUser {
  id                 String      @id @default(uuid()) @db.Uuid
  email              String      @unique
  passwordHash       String      @map("password_hash")
  displayName        String      @map("display_name")
  role               AppUserRole
  active             Boolean     @default(true)
  deviceFingerprints String[]    @default([]) @map("device_fingerprints")
  totpSecret         String?     @map("totp_secret")
  totpEnabled        Boolean     @default(false) @map("totp_enabled")
  totpVerifiedAt     DateTime?   @map("totp_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int         @default(1)

  refreshTokens   RefreshToken[]
  importJobs      ImportJob[]
  personVersions  PersonVersion[]      @relation("ChangedBy")
  personsCreated  Person[]             @relation("CreatedBy")
  personsUpdated  Person[]             @relation("UpdatedBy")
  amsExports      AmsExport[]
  passwordReveals PasswordRevealLog[]

  @@map("app_users")
}

model School {
  id            String     @id
  /// Schulnummer (same as id by convention, e.g. 50267)
  /// KZ-OU short code (e.g. gym-gsdg)
  code          String     @unique @map("code")
  /// KZ-SNr – school index for STO groups (e.g. 45). Empty until set; not auto from GUID.
  kzSnr         String?    @map("kz_snr")
  name          String
  type          SchoolType
  location      String?
  amsLocationId String     @default(uuid()) @map("ams_location_id") @db.Uuid
  active        Boolean    @default(true)
  config        Json       @default("{}")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version       Int        @default(1)

  @@map("schools")
}

/// All sensitive attributes stored encrypted (AES-GCM). Hashes enforce uniqueness / filters.
model Person {
  id String @id @default(uuid()) @db.Uuid

  /// Blind index of LKID (unique)
  lkidHash String @unique @map("lkid_hash")
  /// Encrypted LKID
  lkid     String

  /// Blind index of AMS person UUID (unique)
  amsIdHash String @unique @map("ams_id_hash")
  /// Encrypted AMS id
  amsId     String @map("ams_id")

  /// Blind index of school id (for filter; integrity app-level)
  schoolIdHash String @map("school_id_hash")
  /// Encrypted school id
  schoolId     String @map("school_id")

  lastName  String @map("last_name")
  firstName String @map("first_name")

  /// Encrypted ISO date string YYYY-MM-DD
  dateOfBirth String? @map("date_of_birth")
  /// SCHULBEG – first school entry date (encrypted ISO YYYY-MM-DD)
  schoolEntryDate String? @map("school_entry_date")
  /// SCHULEND – school end date if present (encrypted ISO)
  schoolEndDate   String? @map("school_end_date")

  gender String? @db.Char(1)

  email    String?
  emailMdm String? @map("email_mdm")

  usernameHash String? @unique @map("username_hash")
  username     String?

  appleId String? @map("apple_id")

  /// Encrypted reversible person password
  password String?

  /// Encrypted JSON array of role strings (schueler|lehrer|sonstige|klassenlehrer)
  roles String

  className     String? @map("class_name")
  /// Blind index for (school + class) uniqueness when class set
  classNameHash String? @map("class_name_hash")

  grade     String?
  gradeHash String? @map("grade_hash")

  /// Encrypted JSON array of app flags
  applications String @default("[]")

  activeAttendance Boolean @default(true) @map("active_attendance")
  terminated       Boolean @default(false)

  note     String?
  importId String? @map("import_id")
  sourceId String? @map("source_id")

  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy AppUser?        @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy AppUser?        @relation("UpdatedBy", fields: [updatedById], references: [id])
  versions  PersonVersion[]

  @@index([schoolIdHash])
  @@index([schoolIdHash, classNameHash])
  @@index([usernameHash])
  @@map("persons")
}

model PersonVersion {
  id           String   @id @default(uuid()) @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  version      Int
  snapshot     Json
  changedById  String?  @map("changed_by") @db.Uuid
  changeReason String?  @map("change_reason")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  changedBy AppUser? @relation("ChangedBy", fields: [changedById], references: [id])

  @@unique([personId, version])
  @@map("person_versions")
}

model ImportJob {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  filename   String
  schoolId   String?   @map("school_id")
  status     String    @default("pending")
  stats      Json?
  errors     Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])

  @@map("import_jobs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceFp  String?   @map("device_fp")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model RoleDefinition {
  id            String   @id
  name          String
  canonical     String
  aliases       String[] @default([])
  accountType   Int      @map("account_type")
  defaultFlags  String[] @default([]) @map("default_flags")
  description   String?
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("role_definitions")
}

model AmsExport {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  schoolId  String?  @map("school_id")
  stats     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])

  @@map("ams_exports")
}

model PasswordRevealLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  scope     String
  scopeRef  String?  @map("scope_ref")
  count     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])

  @@map("password_reveal_logs")
}
