generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  salt              String
  role              String    @default("operator")
  mustChangePassword Boolean  @default(true)
  active            Boolean   @default(true)
  totpSecret     String?
  totpEnabled       Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolTypeConfig {
  prefix    String   @id
  label     String
  createdAt DateTime @default(now())
  schools   School[]
}

model School {
  id            String   @id @default(uuid())
  sid           String   @unique
  sgid          String
  soid          String
  name          String
  typeId        String?
  type          SchoolTypeConfig? @relation(fields: [typeId], references: [prefix])
  config        Json     @default("{}")
  amsLocationId String   @unique @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  persons       PersonSchool[]
  classes       SchoolClass[]
}

model SchoolClass {
  id        String   @id @default(uuid())
  schoolId  String
  lkid      String
  name      String
  classKey  String
  active    Boolean  @default(true)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, name])
  @@index([lkid])
}

model RoleDefinition {
  id       String   @id @default(uuid())
  vceType  Int      @unique
  dataId   String   @unique
  label    String
  aliases  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persons  PersonRole[]
}

model FlagDefinition {
  id        String   @id @default(uuid())
  dataId    String   @unique
  label     String
  requires  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persons   PersonFlag[]
  groups    GroupFlag[]
}

model GroupFlag {
  id       String   @id @default(uuid())
  flagId   String
  roleId   String?
  schoolId String?
  flag     FlagDefinition @relation(fields: [flagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([flagId, roleId, schoolId])
}

model Person {
  id              String   @id @default(uuid())
  lkid            String   @unique
  amsId           String   @unique @default(uuid())
  name         String
  firstName    String
  email        String?
  workEmail    String?
  password     String?
  dateOfBirth     DateTime?
  username        String   @unique
  appleId         String?
  systemEmail     String?
  schoolStart     DateTime?
  schoolEnd       DateTime?
  stufe           String?
  active          Boolean  @default(true)
  sex             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  schools         PersonSchool[]
  roles           PersonRole[]
  flags           PersonFlag[]
  classes         PersonClass[]
  versions        PersonVersion[]
}

model PersonSchool {
  personId String
  schoolId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@id([personId, schoolId])
}

model PersonRole {
  personId String
  roleId   String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     RoleDefinition @relation(fields: [roleId], references: [id])
  @@id([personId, roleId])
}

model PersonFlag {
  personId String
  flagId   String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  flag     FlagDefinition @relation(fields: [flagId], references: [id])
  @@id([personId, flagId])
}

model PersonClass {
  id       String @id @default(uuid())
  personId String
  schoolId String
  classKey String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@unique([personId, classKey])
}

model PersonVersion {
  id        String   @id @default(uuid())
  personId  String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id        String   @id @default(uuid())
  filename  String
  status    String
  stats     Json
  createdAt DateTime @default(now())
}

model PasswordRevealLog {
  id        String   @id @default(uuid())
  userId    String
  scope     String
  ref       String?
  createdAt DateTime @default(now())
}

model KeyVersion {
  version     Int      @id
  wrappedKey  String
  wrappedPrev String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  details    Json
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}